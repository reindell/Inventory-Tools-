{
  "name": "sdp-inventory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "npm run typecheck && vite build && tsup server/index.ts server/cli.ts --format esm --platform node --out-dir dist-server --external sharp --external @electric-sql/pglite --external pg --external mssql --external mssql/msnodesqlv8.js && node scripts/copy-worker.mjs",
    "start": "node dist-server/index.js",
    "db:migrate": "tsx server/cli.ts migrate",
    "db:seed": "tsx server/cli.ts seed",
    "db:samples": "tsx server/cli.ts samples",
    "db:reconcile": "tsx server/cli.ts reconcile",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "audit:dependencies": "npm audit --omit=dev",
    "brand:generate": "tsx scripts/brand.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.922.0",
    "@aws-sdk/s3-request-presigner": "^3.922.0",
    "@electric-sql/pglite": "^0.3.14",
    "@hookform/resolvers": "^6.0.2",
    "@tanstack/react-query": "^5.90.0",
    "bcryptjs": "^3.0.2",
    "bwip-js": "^4.7.0",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.6.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "fast-xml-parser": "^5.3.0",
    "file-type": "^21.1.1",
    "helmet": "^8.1.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "mssql": "^12.0.0",
    "multer": "^2.0.2",
    "nodemailer": "^10.3.1",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.66.0",
    "react-router-dom": "^7.9.5",
    "sharp": "^0.35.5",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.1.17",
    "@types/bwip-js": "^3.2.3",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.5",
    "@types/mssql": "^12.3.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.3",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "tailwindcss": "^4.1.17",
    "tsup": "^8.5.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^7.2.2",
    "vitest": "^5.0.5"
  },
  "optionalDependencies": {
    "msnodesqlv8": "^6.2.1"
  }
}
