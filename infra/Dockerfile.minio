# Reference S3 service for evaluation/private-server testing. Review lifecycle and
# patch ownership before live use; the upstream community repositories are archived.
FROM golang:1.26-alpine AS build
ENV CGO_ENABLED=0
RUN go install github.com/minio/minio@RELEASE.2025-10-15T17-29-55Z
RUN go install github.com/minio/mc@RELEASE.2025-08-13T08-35-41Z

FROM alpine:3.23
RUN apk add --no-cache ca-certificates tzdata && \
    addgroup -g 10001 minio && adduser -D -u 10001 -G minio minio && \
    mkdir -p /data /home/minio/.mc && chown -R minio:minio /data /home/minio/.mc
COPY --from=build /go/bin/minio /usr/local/bin/minio
COPY --from=build /go/bin/mc /usr/local/bin/mc
ADD https://raw.githubusercontent.com/minio/minio/RELEASE.2025-10-15T17-29-55Z/LICENSE /licenses/minio-LICENSE
ADD https://raw.githubusercontent.com/minio/mc/RELEASE.2025-08-13T08-35-41Z/LICENSE /licenses/mc-LICENSE
USER minio
EXPOSE 9000 9001
ENTRYPOINT ["minio"]
