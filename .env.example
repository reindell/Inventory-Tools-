# Production Docker template. Local development needs no .env file.
# Generate distinct secrets with: node scripts/configure.mjs inventory.example.internal admin@example.com
APP_HOST=inventory.example.internal
APP_ORIGIN=https://inventory.example.internal
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
JWT_SECRET=
COOKIE_SECRET=
DB_PASSWORD=
APP_DB_PASSWORD=
# SQL Server Express is used by Docker. All three database passwords must be distinct
# and satisfy SQL Server complexity policy (uppercase/lowercase/digits/symbols).
SQLSERVER_SA_PASSWORD=
# Docker's SQL Server uses its local TLS certificate. Set false with a trusted SQL certificate.
SQLSERVER_TRUST_SERVER_CERTIFICATE=true
MINIO_ROOT_USER=sdp-storage-root
MINIO_ROOT_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Use a reachable SMTP server. Percent-encode reserved characters in SMTP credentials.
SMTP_URL=
EMAIL_FROM=SDP Inventory <inventory@example.com>
# No sample stock is seeded in production. Company identity is fixed to Shindengen.
SEED_SAMPLE_DATA=false
# Only for npm scripts outside Compose; production app and migration URLs use separate roles.
# DATABASE_URL=mssql://sdp_app:URL_ENCODED_PASSWORD@localhost:1433/sdp?encrypt=true&trustServerCertificate=true
# TEST_DATABASE_URL=mssql://sdp_test:URL_ENCODED_PASSWORD@localhost:1433/sdp_test?encrypt=true&trustServerCertificate=true
# Optional local Windows integrated authentication (ODBC Driver 18 required; no password in URL):
# DATABASE_URL=mssql+windows://localhost/sdp?instance=SQLEXPRESS2022&encrypt=false&trustServerCertificate=true
# With no DATABASE_URL, local development keeps the legacy embedded database under .data/postgres.
